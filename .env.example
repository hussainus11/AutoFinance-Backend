DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/autofinance?schema=public"
PORT=4000

# 32-byte secret for encrypting branch tokens (AES-256-GCM)
AF_SECRET_KEY=change_me_to_a_random_32_byte_value

# --- Auth (JWT access/refresh sessions) ---
# 32+ byte random secret for signing JWT access/refresh tokens (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_to_a_random_48_byte_base64_value

# Cookie Secure flag. Must be "false" only when running the frontend over plain HTTP (npm run dev:http).
# Leave "true" for the default HTTPS dev flow and for production.
COOKIE_SECURE=true

# Access/refresh token lifetimes (optional overrides; defaults shown)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Frontend origin used to build partner-portal invite links (no email/SMS delivery exists yet,
# so staff copy this link and share it with the partner directly).
PORTAL_BASE_URL=https://localhost:3000

# --- Platform Meta WhatsApp (set ONCE by Auto Finance operator, not end users) ---
# End users only click "Connect with Meta" in the app; Meta's popup handles the rest.
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_OAUTH_REDIRECT_URI=https://localhost:3000/
META_GRAPH_VERSION=v25.0
META_WHATSAPP_VERIFY_TOKEN=change_me
